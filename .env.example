# Required: bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Optional: server ID for instant slash-command sync (recommended, avoids
# Discord's up-to-one-hour global sync delay). Leave blank to sync globally.
# To get it: Discord settings -> My Accounts -> "Copy ID" with Developer Mode on.
DISCORD_GUILD_ID=